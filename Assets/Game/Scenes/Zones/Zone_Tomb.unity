  m_Name: 
  m_EditorClassIdentifier: Game.Runtime::ForgottenKingdom.Inscription
  _text: "\u041C\u0438 \u0437\u0430\u043C\u0443\u0440\u0443\u0432\u0430\u043B\u0438
    \u0434\u0432\u0435\u0440\u0456 \u0439 \u043F\u043E\u043A\u043B\u0430\u043B\u0438
    \u043A\u043B\u044E\u0447 \u0443 \u0441\u0435\u0440\u0446\u0435 \u0432\u0430\u0440\u0442\u043E\u0432\u043E\u0433\u043E.
    \u0425\u0430\u0439 \u0442\u0456\u043D\u044C, \u0449\u043E \u0432\u0438\u0439\u0434\u0435
    \u0437\u0432\u0456\u0434\u0441\u0438, \u0437\u043D\u0430\u0454: \u0457\u0457
    \u043D\u0435 \u043A\u043B\u0438\u043A\u0430\u043B\u0438."
