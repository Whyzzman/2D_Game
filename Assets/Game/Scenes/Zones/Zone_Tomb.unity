    \u041D\u0435 \u0442\u043E\u043C\u0443, \u0449\u043E \u043C\u0435\u0440\u0442\u0432\u0456
    \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456, \u2014 \u0442\u043E\u043C\u0443,
    \u0449\u043E \u0432\u043E\u043D\u0438 \u043F\u0430\u043C'\u044F\u0442\u0430\u044E\u0442\u044C,
    \u044F\u043A \u0431\u0443\u043B\u043E \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456."
