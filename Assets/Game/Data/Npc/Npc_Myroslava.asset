--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 42960b0b7a3c64c3d9eadd45d5fe2e25, type: 3}
  m_Name: Npc_Myroslava
  m_EditorClassIdentifier: Game.Runtime::ForgottenKingdom.NpcDefinition
  _npcId: myroslava
  _displayName: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0446\u044F \u041C\u0438\u0440\u043E\u0441\u043B\u0430\u0432\u0430"
  _epithet: "\u0448\u0443\u043A\u0430\u0447\u043A\u0430 \u0432\u043E\u0433\u043D\u044E"
  _topics:
  - id: altar
    requiresBoss: 
    untilBoss: guardian-of-the-tomb
    once: 1
    pages:
    - "\u0426\u0435\u0439 \u0432\u0456\u0432\u0442\u0430\u0440 \u0449\u0435 \u0442\u0435\u043F\u043B\u0438\u0439.
      \u0425\u0442\u043E\u0441\u044C \u0437\u0430\u043F\u0430\u043B\u0438\u0432 \u0439\u043E\u0433\u043E
      \u0434\u043E \u0442\u0435\u0431\u0435 \u2014 \u0430\u0431\u043E \u0432\u0456\u043D
      \u0442\u0430\u043A \u0456 \u043D\u0435 \u0437\u0433\u0430\u0441."
    - "\u0422\u0440\u0438\u0441\u0442\u0430 \u0440\u043E\u043A\u0456\u0432\u2026
      \u0430 \u0432\u043E\u0433\u043E\u043D\u044C \u043F\u0430\u043C'\u044F\u0442\u0430\u0454
      \u043A\u043E\u0440\u043E\u043B\u0456\u0432\u0441\u044C\u043A\u0443 \u0440\u0443\u043A\u0443."
    - "\u042F \u0448\u0443\u043A\u0430\u044E \u0437\u0433\u0430\u0441\u043B\u0456
      \u0432\u0456\u0432\u0442\u0430\u0440\u0456. \u041F\u043E\u0431\u0430\u0447\u0438\u0448
      \u0445\u043E\u043B\u043E\u0434\u043D\u0438\u0439 \u2014 \u0437\u0430\u043F\u0430\u043B\u0438.
      \u0412\u0456\u043D \u0432\u0456\u0434\u0434\u044F\u0447\u0438\u0442\u044C."
    journalNote: "\u0428\u0443\u043A\u0430\u0454 \u0437\u0433\u0430\u0441\u043B\u0456
      \u0432\u0456\u0432\u0442\u0430\u0440\u0456. \u0420\u0430\u0434\u0438\u0442\u044C
      \u0437\u0430\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438 \u043A\u043E\u0436\u0435\u043D."
  - id: guardian
    requiresBoss: 
    untilBoss: guardian-of-the-tomb
    once: 0
    pages:
    - "\u0414\u0430\u043B\u0456 \u2014 \u0421\u0442\u0440\u0430\u0436. \u0412\u0456\u043D
      \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0454 \u043D\u0456\u043A\u043E\u0433\u043E.
      \u0412\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u044C, \u043F\u0435\u0440\u0448
      \u043D\u0456\u0436 \u0456\u0442\u0438."
    journalNote: 
  - id: forest
    requiresBoss: guardian-of-the-tomb
    untilBoss: hollow-warden
    once: 1
    pages:
    - "\u0422\u0438 \u043F\u0440\u043E\u0439\u0448\u043E\u0432 \u0421\u0442\u0440\u0430\u0436\u0430?
      \u0422\u043E\u0434\u0456 \u0439 \u043C\u0435\u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438
      \u0434\u043E \u0432\u043E\u0433\u043D\u044E."
    - "\u0423 \u041B\u0456\u0441\u0456 \u0432\u043E\u0433\u043E\u043D\u044C \u0433\u043E\u0440\u0438\u0442\u044C
      \u0456\u043D\u0430\u043A\u0448\u0435. \u0417\u0435\u043B\u0435\u043D\u0456\u0448\u0435.
      \u041D\u0430\u0447\u0435 \u0449\u043E\u0441\u044C \u043F'\u0454 \u0437 \u043D\u044C\u043E\u0433\u043E."
    - "\u0412\u0430\u0440\u0442\u043E\u0432\u0438\u0439 \u2014 \u0433\u043B\u0438\u0431\u0448\u0435
      \u0432 \u043B\u0456\u0441\u0456. \u041A\u043E\u0440\u0435\u043D\u0456 \u0441\u043B\u0443\u0445\u0430\u044E\u0442\u044C
      \u0439\u043E\u0433\u043E, \u043D\u0435 \u043A\u043E\u0440\u043E\u043B\u044F."
    journalNote: "\u041A\u0430\u0436\u0435, \u0449\u043E \u0432\u043E\u0433\u043E\u043D\u044C
      \u0443 \u041B\u0456\u0441\u0456 \u0433\u043E\u0440\u0438\u0442\u044C \u0456\u043D\u0430\u043A\u0448\u0435."
  - id: roots
    requiresBoss: guardian-of-the-tomb
    untilBoss: hollow-warden
    once: 0
    pages:
    - "\u041A\u043E\u0440\u0435\u043D\u0456 \u043F\u0430\u043C'\u044F\u0442\u0430\u044E\u0442\u044C
      \u043A\u043E\u0436\u0435\u043D \u043A\u0440\u043E\u043A. \u041D\u0435 \u0437\u0443\u043F\u0438\u043D\u044F\u0439\u0441\u044F
      \u043D\u0430\u0434\u043E\u0432\u0433\u043E."
    journalNote: 
  - id: church
    requiresBoss: bellringer
    untilBoss: 
    once: 1
    pages:
    - "\u0426\u0435\u0440\u043A\u0432\u0430 \u0441\u0442\u043E\u044F\u043B\u0430
      \u043F\u043E\u0440\u043E\u0436\u043D\u044F, \u0434\u043E\u043A\u0438 \u0434\u0437\u0432\u0456\u043D
      \u0431\u0438\u0432 \u0441\u0430\u043C. \u0422\u0435\u043F\u0435\u0440 \u0442\u0443\u0442
      \u0437\u043D\u043E\u0432\u0443 \u043C\u043E\u0436\u043D\u0430 \u043C\u043E\u043B\u0438\u0442\u0438\u0441\u044F."
    - "\u041F\u0456\u0434 \u0446\u0435\u0440\u043A\u0432\u043E\u044E \u2014 \u043A\u0440\u0438\u043F\u0442\u0430.
      \u0421\u0435\u043B\u044F\u043D\u0438 \u0445\u043E\u0432\u0430\u043B\u0438 \u0442\u0430\u043C
      \u0442\u0435, \u0449\u043E \u043D\u0435 \u0432\u0456\u0434\u0434\u0430\u043B\u0438
      \u043A\u043E\u0440\u043E\u043B\u044E."
    - "\u041C\u043E\u044F \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u0443\u0442
      \u043A\u0456\u043D\u0447\u0430\u0454\u0442\u044C\u0441\u044F. \u0422\u0432\u043E\u044F
      \u2014 \u0432\u043D\u0438\u0437, \u0434\u043E \u0421\u0442\u043E\u043B\u0438\u0446\u0456."
    journalNote: "\u041F\u0435\u0440\u0435\u0439\u0448\u043B\u0430 \u0434\u043E \u0441\u0456\u043B\u044C\u0441\u044C\u043A\u043E\u0457
      \u0446\u0435\u0440\u043A\u0432\u0438. \u041A\u0430\u0436\u0435, \u043F\u0456\u0434
      \u043D\u0435\u044E \u043A\u0440\u0438\u043F\u0442\u0430."
  - id: end
    requiresBoss: hollow-warden
    untilBoss: bellringer
    once: 1
    pages:
    - "\u041B\u0456\u0441 \u0437\u0430\u0442\u0438\u0445. \u042F \u0447\u0443\u044E
      \u0432\u043E\u0433\u043E\u043D\u044C \u2014 \u0432\u0456\u043D \u0437\u043D\u043E\u0432\u0443
      \u0447\u0438\u0441\u0442\u0438\u0439."
    - "\u041C\u043E\u044F \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u0443\u0442
      \u043A\u0456\u043D\u0447\u0430\u0454\u0442\u044C\u0441\u044F. \u0422\u0432\u043E\u044F
      \u2014 \u043D\u0456. \u0421\u0445\u0456\u0434 \u0447\u0435\u043A\u0430\u0454."
    journalNote: "\u041B\u0438\u0448\u0438\u043B\u0430\u0441\u044F \u0431\u0456\u043B\u044F
      \u0432\u0456\u0432\u0442\u0430\u0440\u044F \u0433\u043B\u0438\u0431\u043E\u043A\u043E\u0433\u043E
      \u043B\u0456\u0441\u0443. \u0407\u0457 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044C."
  - id: farewell
    requiresBoss: hollow-warden
    untilBoss: 
    once: 0
    pages:
    - "\u0425\u0430\u0439 \u0432\u043E\u0433\u043E\u043D\u044C \u0442\u0440\u0438\u043C\u0430\u0454
      \u0442\u0435\u0431\u0435."
    journalNote: 
  _stock: {fileID: 0}
