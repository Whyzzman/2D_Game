  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 42960b0b7a3c64c3d9eadd45d5fe2e25, type: 3}
  m_Name: Npc_Gnat
  m_EditorClassIdentifier: Game.Runtime::ForgottenKingdom.NpcDefinition
  _npcId: gnat
  _displayName: "\u0421\u043A\u0443\u043F\u043D\u0438\u043A \u0413\u043D\u0430\u0442"
  _epithet: "\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446\u044C"
  _topics:
  - id: meet
    requiresBoss: 
    untilBoss: guardian-of-the-tomb
    once: 1
    pages:
    - "\u0416\u0438\u0432\u0438\u0439? \u0420\u0456\u0434\u043A\u0456\u0441\u0442\u044C
      \u0443 \u0446\u0438\u0445 \u0441\u0442\u0456\u043D\u0430\u0445."
    - "\u042F \u0413\u043D\u0430\u0442. \u0421\u043A\u0443\u043F\u043E\u0432\u0443\u044E,
      \u0449\u043E \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F \u0432\u0456\u0434
      \u043A\u043E\u0440\u043E\u043B\u0456\u0432\u0441\u0442\u0432\u0430, \u0456
      \u043F\u0440\u043E\u0434\u0430\u044E \u0442\u0438\u043C, \u0445\u0442\u043E
      \u0449\u0435 \u0434\u0438\u0445\u0430\u0454."
    - "\u0417\u043E\u043B\u043E\u0442\u043E \u043C\u0430\u0454\u0448 \u2014 \u0442\u043E\u0432\u0430\u0440
      \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u044C\u0441\u044F. \u0427\u0443\u0442\u043A\u0438
      \u0442\u0435\u0436, \u0442\u0430 \u0432\u043E\u043D\u0438 \u0434\u043E\u0440\u043E\u0436\u0447\u0456."
    journalNote: "\u0421\u043A\u0443\u043F\u043D\u0438\u043A \u0431\u0456\u043B\u044F
      \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0432\u0456\u0432\u0442\u0430\u0440\u044F.
      \u0422\u043E\u0440\u0433\u0443\u0454 \u043A\u0430\u0440\u0442\u0430\u043C\u0438,
      \u0443\u043B\u0430\u043C\u043A\u0430\u043C\u0438 \u0444\u043B\u044F\u0433 \u0456
      \u0447\u0443\u0442\u043A\u0430\u043C\u0438."
  - id: moved
    requiresBoss: guardian-of-the-tomb
    untilBoss: 
    once: 1
    pages:
    - "\u0421\u0442\u0440\u0430\u0436 \u0443\u043F\u0430\u0432? \u041E\u0442\u0436\u0435,
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0432 \u041B\u0456\u0441 \u0432\u0456\u0434\u0447\u0438\u043D\u0435\u043D\u0430."
    - "\u042F \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0432\u0441\u044F \u0441\u044E\u0434\u0438.
      \u0411\u0456\u043B\u044F \u043C\u0435\u0440\u0442\u0432\u0438\u0445 \u0434\u0435\u0440\u0435\u0432
      \u0442\u043E\u0440\u0433\u0443\u0432\u0430\u0442\u0438 \u043A\u0440\u0430\u0449\u0435,
      \u043D\u0456\u0436 \u0431\u0456\u043B\u044F \u043C\u0435\u0440\u0442\u0432\u0438\u0445
      \u043A\u043E\u0440\u043E\u043B\u0456\u0432."
    - "\u041D\u0430 \u0432\u043E\u0437\u0456 \u0454 \u0439 \u043D\u043E\u0432\u0435
      \u2014 \u0434\u043B\u044F \u041B\u0456\u0441\u0443."
    journalNote: "\u041F\u0435\u0440\u0435\u0457\u0445\u0430\u0432 \u0437\u0430 \u0432\u0430\u043C\u0438
      \u0432 \u041B\u0456\u0441. \u041F\u0440\u0438\u0432\u0456\u0437 \u0442\u0435,
      \u0449\u043E \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0432 \u0443 \u0413\u0440\u043E\u0431\u043D\u0438\u0446\u0456."
  - id: east
    requiresBoss: hollow-warden
    untilBoss: 
    once: 1
    pages:
    - "\u0412\u0430\u0440\u0442\u043E\u0432\u043E\u0433\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0435\u043C\u0430\u2026 \u041B\u0456\u0441 \u043D\u0456\u0431\u0438
      \u0432\u0438\u0434\u0438\u0445\u043D\u0443\u0432."
    - "\u041A\u0430\u0436\u0443\u0442\u044C, \u0437\u0430 \u043A\u0440\u0430\u0454\u043C
      \u043B\u0456\u0441\u0443 \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0430
      \u0441\u0445\u0456\u0434. \u0417\u0430\u043C\u043A\u043D\u0435\u043D\u0430.
      \u041F\u043E\u043A\u0438 \u0449\u043E."
    journalNote: "\u041A\u0430\u0436\u0435, \u0449\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u043D\u0430 \u0441\u0445\u0456\u0434 \u0437\u0430 \u043B\u0456\u0441\u043E\u043C
      \u0449\u0435 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0430."
  - id: again
    requiresBoss: 
    untilBoss: 
    once: 0
    pages:
    - "\u041D\u0443, \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044C,
      \u0449\u043E \u0432 \u0442\u0435\u0431\u0435 \u0432 \u0433\u0430\u043C\u0430\u043D\u0446\u0456."
    journalNote: 
  _stock: {fileID: 11400000, guid: 11453b18fe2b64260bf2ccdad4e835d8, type: 2}
