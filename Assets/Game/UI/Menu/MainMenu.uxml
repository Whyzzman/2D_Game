<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainMenu.uss" />
    <Style src="Options.uss" />
    <Style src="Controls.uss" />
    <ui:VisualElement name="menu" class="menu">
        <ui:VisualElement name="vignette" class="menu__vignette" picking-mode="Ignore" />
        <ui:VisualElement name="fade" class="menu__fade" picking-mode="Ignore" />

        <ui:VisualElement name="front" class="menu__front">
            <ui:Label class="title display motion" text="ТІНЬ" picking-mode="Ignore" />
            <ui:Label class="title title--second display motion" text="Забутого Королівства" picking-mode="Ignore" />
            <ui:VisualElement class="title__rule ornament motion" picking-mode="Ignore" />
            <ui:Label class="title__small display motion" text="Пролог" picking-mode="Ignore" />

            <!-- design/ui/menus/menus.html: words without boxes; MenuFocus draws the light, the flame and the threads. -->
            <ui:VisualElement name="list" class="menu-list">
                <ui:Button name="continue" class="menu-button display motion" text="Продовжити">
                    <ui:Label class="menu-button__note" text="Збереження немає" picking-mode="Ignore" />
                </ui:Button>
                <!-- design/ui/ending/ending.html frame 6: only once the game is completed. -->
                <ui:Button name="new-game-plus" class="menu-button display motion" text="Нова гра+" />
                <ui:Button name="new-game" class="menu-button display motion" text="Нова гра" />
                <ui:Button name="options" class="menu-button display motion" text="Налаштування" />
                <ui:Button name="controls" class="menu-button display motion" text="Керування" />
                <ui:Button name="quit" class="menu-button display motion" text="Вийти" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- design/ui/menus/menus.html, state 4: one panel, two groups, a line explaining the focused row. -->
        <ui:VisualElement name="options-panel" class="options motion">
            <ui:VisualElement class="gem gem--tl" picking-mode="Ignore" />
            <ui:VisualElement class="gem gem--tr" picking-mode="Ignore" />
            <ui:VisualElement class="gem gem--bl" picking-mode="Ignore" />
            <ui:VisualElement class="gem gem--br" picking-mode="Ignore" />
            <ui:Label class="options__title display" text="Налаштування" picking-mode="Ignore" />
            <ui:VisualElement class="options__rule ornament" picking-mode="Ignore" />
            <ui:Label class="options__group display options__line motion motion--line" text="Звук" picking-mode="Ignore" />
            <ui:Slider name="opt-master" class="option options__line motion motion--line" label="Загальна гучність" low-value="0" high-value="1" />
            <ui:Slider name="opt-music" class="option options__line motion motion--line" label="Музика" low-value="0" high-value="1" />
            <ui:Slider name="opt-effects" class="option options__line motion motion--line" label="Ефекти" low-value="0" high-value="1" />
            <ui:Label class="options__group options__group--gap display options__line motion motion--line" text="Екран і доступність" picking-mode="Ignore" />
            <ui:Slider name="opt-shake" class="option options__line motion motion--line" label="Тремтіння камери" low-value="0" high-value="1" />
            <ui:Slider name="opt-flash" class="option options__line motion motion--line" label="Спалахи" low-value="0" high-value="1" />
            <ui:Slider name="opt-hitstop" class="option options__line motion motion--line" label="Зупинка при ударі" low-value="0" high-value="1" />
            <ui:Toggle name="opt-post" class="option option--toggle options__line motion motion--line" label="Ефекти зображення" value="true" />
            <ui:Label name="options-help" class="options__help" text="" picking-mode="Ignore" />
            <ui:Button name="options-back" class="menu-button menu-button--small display" text="Назад" />
        </ui:VisualElement>

        <!-- design/ui/controls/controls.html, frame 6: the same controls screen as in the pause. -->
        <ui:VisualElement name="controls-panel" class="controls" />

        <!-- design/ui/menus/menus.html, frame 3: the modal takes the input; the menu under it does not react. -->
        <ui:VisualElement name="confirm-new" class="confirm motion motion--fade">
            <ui:VisualElement class="confirm__panel motion motion--grow">
                <ui:VisualElement class="confirm__inset" picking-mode="Ignore" />
                <ui:VisualElement class="confirm__header" picking-mode="Ignore">
                    <ui:Label name="confirm-title" class="confirm__title display" text="ПОЧАТИ НОВУ ГРУ?" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="confirm__body">
                    <ui:Label name="confirm-text" class="confirm__text" text="Поточне проходження буде стерто назавжди." picking-mode="Ignore" />
                    <ui:Label name="confirm-save" class="confirm__save" text="" picking-mode="Ignore" />
                    <ui:VisualElement class="confirm__row">
                        <ui:Button name="confirm-cancel" class="btn"><ui:Label class="btn__text" text="Скасувати" picking-mode="Ignore" /></ui:Button>
                        <ui:VisualElement class="confirm__spacer" picking-mode="Ignore" />
                        <ui:Button name="confirm-erase" class="btn btn--danger"><ui:Label name="confirm-erase-text" class="btn__text" text="Стерти й почати" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="save-meta" class="save-meta" text="Збереження не знайдено" picking-mode="Ignore" />
        <ui:Label name="build-tag" class="build-tag" text="Вертикальний зріз" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
