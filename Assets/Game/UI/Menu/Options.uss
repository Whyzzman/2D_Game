/*
 * Buttons and the settings panel shared by the title screen and the pause menu, from
 * design/ui/menus/menus.html. Moved out of MainMenu.uss unchanged so both screens stay alike.
 */

.menu-button {
    height: 52px;
    margin: 0 0 12px 0;
    font-size: 20px;
    letter-spacing: 4px;
    color: rgb(216, 203, 180);
    background-color: rgba(15, 13, 11, 0.72);
    border-width: 1px;
    border-color: rgb(58, 47, 37);
    border-radius: 2px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, translate;
    transition-duration: 0.15s;
}

.menu-button:hover,
.menu-button--focused {
    color: rgb(240, 230, 210);
    background-color: rgba(60, 46, 24, 0.85);
    border-color: rgb(201, 161, 74);
    border-left-width: 3px;
    translate: 4px 0;
}

/* Disabled, not hidden: it has to read as "there is no save", so it stays legible. */
.menu-button:disabled {
    color: rgb(142, 131, 117);
    background-color: rgba(11, 9, 7, 0.78);
    border-color: rgb(58, 47, 37);
    translate: 0 0;
    opacity: 0.75;
}

.menu-button--small {
    width: 220px;
    align-self: center;
    margin-top: 18px;
}

.options {
    position: absolute;
    left: 50%;
    top: 26%;
    width: 640px;
    translate: -50% 0;
    padding: 28px 40px 24px 40px;
    background-color: rgba(15, 13, 11, 0.94);
    border-width: 1px;
    border-color: rgb(138, 116, 52);
    display: none;
}

.options--open {
    display: flex;
}

.options__title {
    font-size: 30px;
    letter-spacing: 6px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
}

.options__rule {
    margin: 6px 60px 18px 60px;
}

.option {
    margin: 6px 0;
}

.option > Label {
    min-width: 240px;
    font-size: 17px;
    color: rgb(216, 203, 180);
}

.option--focused > Label {
    color: rgb(232, 205, 138);
}

/* ---------- .btn from ui.css: the pause and the title screen's confirmation ---------- */

.btn {
    min-height: 44px;
    margin: 0 0 12px 0;
    padding: 8px 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 18, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 2px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.btn--last {
    margin-bottom: 0;
}

.btn__text {
    font-size: 17px;
    letter-spacing: 2px;
    color: rgb(216, 203, 180);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.btn:hover {
    background-color: rgb(22, 18, 15);
    border-color: rgb(138, 116, 52);
}

.btn:hover > .btn__text {
    color: rgb(240, 230, 210);
}

.btn:active {
    background-color: rgb(34, 28, 23);
}

.btn--primary {
    border-color: rgb(138, 116, 52);
}

.btn--primary > .btn__text {
    color: rgb(232, 205, 138);
}

.btn--focused,
.btn--focused:hover {
    border-color: rgb(201, 161, 74);
    background-color: rgb(40, 32, 20);
}

.btn--focused > .btn__text {
    color: rgb(232, 205, 138);
}

.btn--danger:hover,
.btn--danger.btn--focused {
    border-color: rgb(196, 85, 47);
}

.btn--danger:hover > .btn__text,
.btn--danger.btn--focused > .btn__text {
    color: rgb(240, 185, 164);
}

/* Disabled until its screen reaches the game: legible, but plainly not a way forward. */
.btn:disabled {
    opacity: 0.6;
    background-color: rgb(11, 9, 7);
    border-color: rgb(58, 47, 37);
}

.btn:disabled > .btn__text {
    color: rgb(95, 87, 76);
}

/* Unspent points waiting on that screen. */
.pip {
    width: 9px;
    height: 9px;
    margin-left: 10px;
    background-color: rgb(201, 161, 74);
    rotate: 45deg;
    display: none;
}

.pip--visible {
    display: flex;
}
