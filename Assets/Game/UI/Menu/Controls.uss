/*
 * Key glyphs and the controls screen, from design/ui/controls/controls.html and _shared/ui.css.
 * Shared by the HUD document (pause) and the title screen. Reference 1920x1080.
 * USS has no box shadows or keyframes: the focus glow is a gold border on a gold wash, and the
 * "listening" pulse is a brighter border and wash that ControlsPanel toggles over time.
 */

/* ---------- input glyphs (ui.css .glyph): a key never appears as plain text ---------- */

.key {
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    margin: 0 4px 0 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 230, 210);
    background-color: rgb(42, 36, 30);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-bottom-width: 2px;
    border-bottom-color: rgb(11, 9, 7);
    border-radius: 8px;
}

.key--pad {
    border-radius: 13px;
    background-color: rgb(50, 43, 32);
}

/* ---------- controls ---------- */

.controls {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1440px;
    translate: -50% -50%;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 8px;
    display: none;
}

.controls--open {
    display: flex;
}

.controls__header {
    padding: 12px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
    background-color: rgba(138, 116, 52, 0.1);
}

.controls__title {
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
}

.controls__body {
    padding: 16px 32px 24px 32px;
}

.controls__cols {
    flex-direction: row;
}

.controls__col {
    flex-grow: 1;
    flex-basis: 0;
}

.controls__col--right {
    margin-left: 48px;
}

.controls__row {
    flex-direction: row;
    align-items: center;
}

.controls__head {
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
}

.controls__head-text {
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(138, 116, 52);
    margin: 0;
    padding: 0;
}

.controls__name {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(216, 203, 180);
    margin: 0;
    padding: 0;
}

.controls__cell-head {
    width: 104px;
    margin-left: 8px;
    -unity-text-align: middle-center;
}

.controls__cell-head--pad {
    width: 124px;
}

.controls__section {
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(95, 87, 76);
    margin: 12px 0 2px 0;
    padding: 0;
}

.controls__action {
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 47, 37, 0.5);
}

/* A binding cell: a slot's frame; focused, it turns gold. */
.bind,
.bind:hover,
.bind:active {
    width: 104px;
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 9, 7, 0.6);
    border-width: 1px;
    border-color: rgb(58, 47, 37);
    border-radius: 0;
}

.bind:hover {
    border-color: rgb(107, 90, 66);
}

.bind--pad,
.bind--pad:hover,
.bind--pad:active {
    width: 124px;
}

.bind--focused,
.bind--focused:hover,
.bind--focused:active {
    border-color: rgb(201, 161, 74);
    background-color: rgba(138, 116, 52, 0.12);
}

.bind--listening,
.bind--listening:hover {
    border-color: rgb(232, 205, 138);
}

.bind--pulse {
    background-color: rgba(232, 205, 138, 0.16);
}

.bind--swapped {
    border-color: rgb(138, 116, 52);
    background-color: rgba(240, 180, 65, 0.18);
}

.bind--fixed,
.bind--fixed:hover {
    border-color: rgba(58, 47, 37, 0.6);
    opacity: 0.6;
}

.bind > .key {
    min-width: 24px;
    height: 24px;
    margin: 0;
}

.bind__text {
    font-size: 12px;
    color: rgb(95, 87, 76);
    margin: 0 4px 0 0;
    padding: 0;
}

.bind__listen {
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    color: rgb(232, 205, 138);
    margin: 0;
    padding: 0;
}

.controls__note {
    margin: 12px 0 0 0;
    padding: 8px 12px;
    font-size: 15px;
    white-space: normal;
    color: rgb(232, 205, 138);
    border-left-width: 2px;
    border-left-color: rgb(138, 116, 52);
    background-color: rgba(138, 116, 52, 0.08);
    display: none;
}

.controls__note--shown {
    display: flex;
}

.controls__note--warn {
    color: rgb(196, 85, 47);
    border-left-color: rgb(196, 85, 47);
    background-color: rgba(196, 85, 47, 0.08);
}

.controls__foot {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.controls__hint {
    flex-direction: row;
    align-items: center;
    margin-right: 24px;
}

.controls__hint-text {
    font-size: 15px;
    color: rgb(142, 131, 117);
    margin: 0 0 0 4px;
    padding: 0;
}

.controls__spacer {
    flex-grow: 1;
}

.controls__reset {
    margin: 0;
}

/* ---------- reset confirmation ---------- */

.controls__confirm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.7);
    align-items: center;
    justify-content: center;
    display: none;
}

.controls__confirm--open {
    display: flex;
}

.controls__confirm-panel {
    width: 560px;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
}

.controls__confirm-text {
    font-size: 17px;
    color: rgb(142, 131, 117);
    white-space: normal;
    margin: 0 0 24px 0;
    padding: 0;
}

.controls__confirm-row {
    flex-direction: row;
}

.controls__confirm-row > .btn {
    flex-grow: 1;
    margin: 0 6px;
}
