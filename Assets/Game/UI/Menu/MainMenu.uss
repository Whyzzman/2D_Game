/*
 * Title screen. Follows design/ui/menus/menus.html (2026-10-19): the title, a list of words
 * with MenuFocus behind the focused one, quiet service information in the corners. The Tomb
 * behind it is a real lit scene; MenuCameraDrift makes it breathe.
 */

.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(216, 203, 180);
    font-size: 17px;
}

.menu__vignette,
.menu__fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.menu__fade {
    background-color: rgb(4, 3, 3);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 2.2s;
}

.menu__fade--open {
    opacity: 0;
}

.menu__fade--leaving {
    opacity: 1;
    transition-duration: 0.9s;
}

.display {
    -unity-font-style: bold;
}

.ornament {
    -unity-background-scale-mode: stretch-to-fill;
    height: 22px;
}

.menu__front {
    position: absolute;
    left: 0;
    right: 0;
    top: 15%;
    align-items: center;
    /* Dims under the settings and the confirmation rather than vanishing. */
    transition-property: opacity;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-cubic;
}

.title {
    font-size: 124px;
    letter-spacing: 20px;
    color: rgb(236, 212, 150);
    -unity-text-align: middle-center;
    text-shadow: 0 6px 20px rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    margin: 0;
    padding: 0;
}

.title--second {
    font-size: 54px;
    letter-spacing: 12px;
    margin-top: -4px;
    color: rgb(240, 230, 210);
}

.title__rule {
    width: 620px;
    margin: 10px 0 6px 0;
}

.title__small {
    font-size: 22px;
    letter-spacing: 12px;
    color: rgb(138, 116, 52);
    margin-bottom: 70px;
}

.menu-list {
    width: 560px;
}

.save-meta {
    position: absolute;
    left: 64px;
    bottom: 56px;
    font-size: 15px;
    color: rgb(142, 131, 117);
}

.build-tag {
    position: absolute;
    right: 64px;
    bottom: 56px;
    font-size: 13px;
    color: rgb(95, 87, 76);
}

/* ---------- new game confirmation (menus.html, frame 3) ---------- */

.confirm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

.confirm--open {
    display: flex;
}

.confirm__panel {
    width: 560px;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 2px;
}

.confirm__inset {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    border-width: 1px;
    border-color: rgba(138, 116, 52, 0.35);
}

.confirm__header {
    padding: 12px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
    background-color: rgba(138, 116, 52, 0.1);
}

.confirm__title {
    font-size: 20px;
    letter-spacing: 1px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
}

.confirm__body {
    padding: 24px 32px 32px 32px;
}

.confirm__text {
    font-size: 15px;
    color: rgb(142, 131, 117);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.confirm__save {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 230, 210);
    margin: 4px 0 24px 0;
    padding: 0;
}

.confirm__row {
    flex-direction: row;
}

.confirm__spacer {
    flex-grow: 1;
}

.confirm__row > .btn {
    margin-bottom: 0;
}

