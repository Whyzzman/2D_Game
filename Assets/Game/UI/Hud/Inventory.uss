/*
 * The buttons here are Unity buttons: the default theme paints :hover and :active grey, so each
 * button class restates its own background for those states.
 *
 * The inventory and equipment window, from design/ui/inventory/inventory.html,
 * design/ui/equipment/equipment.html and design/ui/_shared/ui.css. Reference 1920x1080.
 * USS has no grid, gap, gradients, box shadows or ::before, so the grid is a wrapping row with
 * margins, the gradients are their middle tone, the focus glow is a gold border and the
 * "equipped" diamond is an element of its own. Labels are upper case in the markup.
 */

.inv {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.72);
    display: none;
}

.inv--open {
    display: flex;
}

.inv__panel {
    position: absolute;
    left: 96px;
    top: 64px;
    right: 96px;
    bottom: 64px;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 2px;
}

.inv__header {
    flex-direction: row;
    align-items: center;
    padding: 12px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
    background-color: rgba(138, 116, 52, 0.1);
}

.inv__title {
    font-size: 28px;
    color: rgb(240, 230, 210);
    margin: 0 24px 0 0;
    padding: 0;
    min-width: 280px;
}

.inv__pages {
    flex-direction: row;
    flex-grow: 1;
}

.inv__purse {
    flex-direction: row;
    align-items: center;
}

.inv__coin {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(201, 161, 74);
    background-color: rgb(138, 116, 52);
}

.inv__purse-text {
    font-size: 17px;
    color: rgb(201, 161, 74);
    margin: 0;
    padding: 0;
}

/* ---------- tabs (ui.css .tab) ---------- */

.tab {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 0 0;
    padding: 12px 24px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.tab__text {
    font-size: 15px;
    color: rgb(142, 131, 117);
    margin: 0;
    padding: 0;
}

.tab:hover,
.tab:active {
    background-color: rgba(0, 0, 0, 0);
}

.tab:hover > .tab__text {
    color: rgb(216, 203, 180);
}

.tab--active,
.tab--active:hover,
.tab--active:active {
    background-color: rgba(138, 116, 52, 0.12);
    border-color: rgb(58, 47, 37);
    border-bottom-color: rgb(201, 161, 74);
}

.tab--active > .tab__text,
.tab--active:hover > .tab__text {
    color: rgb(232, 205, 138);
}

.tab:disabled {
    opacity: 0.4;
}

.tab > .pip {
    margin-left: 8px;
}

.inv__categories {
    flex-direction: row;
    padding: 0 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
}

/* ---------- pages ---------- */

.inv__page {
    flex-grow: 1;
    display: none;
}

.inv__page--active {
    display: flex;
}

.inv__body {
    flex-grow: 1;
    flex-direction: row;
    padding: 24px;
}

.spacer {
    flex-grow: 1;
}

.section-label {
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(138, 116, 52);
    margin: 0 0 12px 0;
    padding: 0 0 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
}

/* ---------- slots (ui.css .slot) ---------- */

.inv-slot {
    width: 84px;
    height: 84px;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 18, 15);
    border-width: 1px;
    border-color: rgb(58, 47, 37);
    border-radius: 2px;
}

.inv-slot--empty {
    opacity: 0.6;
}

.inv-slot--empty > .inv-slot__diamond {
    width: 14px;
    height: 14px;
    border-width: 1px;
    border-color: rgb(95, 87, 76);
    rotate: 45deg;
}

.inv-slot--uncommon { border-color: rgb(111, 143, 90); }
.inv-slot--rare { border-color: rgb(78, 127, 176); }
.inv-slot--epic { border-color: rgb(155, 107, 214); }
.inv-slot--legendary { border-color: rgb(201, 161, 74); }

.inv-slot--selected {
    border-width: 2px;
    border-color: rgb(201, 161, 74);
    background-color: rgb(40, 32, 20);
}

.inv-slot__equipped {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    background-color: rgb(201, 161, 74);
    rotate: 45deg;
}

.inv-slot__count {
    position: absolute;
    right: 4px;
    bottom: 2px;
    margin: 0;
    padding: 0;
    font-size: 13px;
    color: rgb(240, 230, 210);
}

.item-icon {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-slot--small {
    width: 44px;
    height: 44px;
}

.inv-slot--small > .item-icon {
    width: 26px;
    height: 26px;
}

.inv-slot--medium {
    width: 60px;
    height: 60px;
}

.inv-slot--medium > .item-icon {
    width: 38px;
    height: 38px;
}

/* ---------- items page: grid and panel ---------- */

.inv__grid-scroll {
    flex-grow: 1;
    margin-right: 24px;
}

.inv__grid-scroll .inv-slot {
    margin: 0 12px 12px 0;
}

.detail {
    width: 430px;
}

.detail__content {
    flex-grow: 1;
}

.detail__empty {
    font-size: 15px;
    color: rgb(95, 87, 76);
    -unity-font-style: italic;
    margin: 48px 0 0 0;
    -unity-text-align: middle-center;
}

.detail__name {
    font-size: 20px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.detail__type {
    font-size: 13px;
    letter-spacing: 2px;
    margin: 4px 0 16px 0;
    padding: 0;
    color: rgb(142, 131, 117);
}

.rar-uncommon { color: rgb(111, 143, 90); }
.rar-rare { color: rgb(78, 127, 176); }
.rar-epic { color: rgb(155, 107, 214); }
.rar-legendary { color: rgb(201, 161, 74); }

.detail__desc {
    font-size: 15px;
    color: rgb(142, 131, 117);
    white-space: normal;
    margin: 0 0 16px 0;
    padding: 0;
}

.detail__section {
    margin-bottom: 16px;
}

.compare__head {
    flex-direction: row;
    margin-bottom: 4px;
}

.compare__head-text {
    flex-grow: 1;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(138, 116, 52);
    margin: 0;
    padding: 0;
}

.compare__row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 47, 37, 0.6);
}

.compare__label {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(216, 203, 180);
    margin: 0;
    padding: 0;
}

.compare__val {
    font-size: 15px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

.delta {
    font-size: 15px;
    -unity-font-style: bold;
    margin: 0 0 0 8px;
    padding: 0;
    min-width: 72px;
    -unity-text-align: middle-right;
}

.delta--up { color: rgb(127, 168, 92); }
.delta--down { color: rgb(196, 85, 47); }
.delta--same { color: rgb(142, 131, 117); }

.effect-line {
    font-size: 15px;
    color: rgb(216, 203, 180);
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
}

.requirement {
    font-size: 15px;
    margin: 0 0 4px 0;
    padding: 0;
    color: rgb(142, 131, 117);
}

.requirement--unmet {
    color: rgb(196, 85, 47);
}

.detail__actions {
    flex-direction: row;
    margin-top: 16px;
}

.detail__problem {
    font-size: 15px;
    color: rgb(196, 85, 47);
    white-space: normal;
    margin: 12px 0 0 0;
    padding: 0;
}

/* ---------- equipment page ---------- */

.inv-loadout {
    width: 420px;
    margin-right: 24px;
}

.inv-loadout__group {
    margin-bottom: 16px;
}

.eq-slot {
    flex-direction: row;
    align-items: center;
    margin: 0 0 4px 0;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.eq-slot:hover,
.eq-slot:active {
    border-color: rgb(58, 47, 37);
    background-color: rgba(0, 0, 0, 0);
}

.eq-slot--selected,
.eq-slot--selected:hover,
.eq-slot--selected:active {
    border-color: rgb(201, 161, 74);
    background-color: rgba(138, 116, 52, 0.14);
}

.eq-slot__meta {
    margin-left: 12px;
    align-items: flex-start;
    flex-shrink: 1;
}

.eq-slot__label,
.eq-slot__item {
    -unity-text-align: middle-left;
}

.eq-slot__label {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(95, 87, 76);
    margin: 0;
    padding: 0;
}

.eq-slot__item {
    font-size: 15px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.eq-slot__item--empty {
    color: rgb(95, 87, 76);
    -unity-font-style: italic;
}

.filtered {
    flex-grow: 1;
    margin-right: 24px;
}

.filtered__note {
    font-size: 15px;
    color: rgb(138, 116, 52);
    white-space: normal;
    margin: 0 0 12px 0;
    padding: 8px 12px;
    border-left-width: 2px;
    border-left-color: rgb(138, 116, 52);
    background-color: rgba(138, 116, 52, 0.08);
}

.filtered__list {
    flex-grow: 1;
}

.list__row {
    flex-direction: row;
    align-items: center;
    margin: 0 0 8px 0;
    padding: 8px 12px;
    background-color: rgb(28, 23, 19);
    border-width: 1px;
    border-color: rgb(58, 47, 37);
    border-radius: 0;
}

.list__row:hover,
.list__row:active {
    border-color: rgb(107, 90, 66);
    background-color: rgb(28, 23, 19);
}

.list__row--selected,
.list__row--selected:hover,
.list__row--selected:active {
    border-color: rgb(201, 161, 74);
    background-color: rgb(40, 32, 20);
}

.list__row--focus-lost {
    border-color: rgb(138, 116, 52);
}

.list__name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 15px;
    color: rgb(240, 230, 210);
    margin: 0 0 0 12px;
    padding: 0;
}

.list__tag {
    font-size: 13px;
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    color: rgb(142, 131, 117);
}

.list__tag--equipped { color: rgb(201, 161, 74); }
.list__tag--unmet { color: rgb(196, 85, 47); }

.list__empty {
    font-size: 15px;
    color: rgb(95, 87, 76);
    -unity-font-style: italic;
    margin: 12px 0;
}

.filtered__actions {
    flex-direction: row;
    margin-top: 12px;
}

.filtered__actions > .btn {
    margin-right: 12px;
}

.derived {
    width: 360px;
}

.stat-row {
    flex-direction: row;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 47, 37, 0.6);
}

.stat-row__label {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(216, 203, 180);
    margin: 0;
    padding: 0;
}

.stat-row__value {
    font-size: 15px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
}

.derived__load-label {
    margin-top: 24px;
}

.load {
    height: 12px;
    background-color: rgba(11, 9, 7, 0.86);
    border-width: 1px;
    border-color: rgb(58, 47, 37);
}

.load__fill {
    height: 100%;
    width: 0;
    background-color: rgb(127, 168, 92);
}

.load__value {
    font-size: 13px;
    color: rgb(142, 131, 117);
    -unity-text-align: middle-right;
    margin: 8px 0 0 0;
    padding: 0;
}

/* ---------- footer ---------- */

.inv__footer {
    flex-direction: row;
    align-items: center;
    padding: 12px 24px;
    border-top-width: 1px;
    border-top-color: rgb(58, 47, 37);
}

.hint {
    flex-direction: row;
    align-items: center;
    margin-right: 24px;
}

.hint__text {
    font-size: 15px;
    color: rgb(142, 131, 117);
    margin: 0 0 0 4px;
    padding: 0;
}

/* ---------- character page (character.html) ---------- */

.ch-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 32px;
}

.ch-col--side {
    flex-grow: 0;
    flex-basis: auto;
    width: 380px;
    margin-right: 0;
}

.ch-gap {
    margin-top: 24px;
}

.ch-level {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 12px;
}

.ch-level__num {
    font-size: 52px;
    color: rgb(232, 205, 138);
    margin: 0 16px 0 0;
    padding: 0;
}

.ch-level__side {
    flex-grow: 1;
    padding-bottom: 8px;
}

.ch-level__row {
    flex-direction: row;
    align-items: center;
}

.ch-level__label {
    font-size: 13px;
    color: rgb(138, 116, 52);
    margin: 0;
    padding: 0;
}

.ch-level__xp {
    font-size: 13px;
    color: rgb(142, 131, 117);
    margin: 0;
    padding: 0;
}

.ch-xp-bar {
    margin-top: 8px;
}

.ch-xp-fill {
    background-color: rgb(201, 161, 74);
}

.ch-points {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: rgb(138, 116, 52);
    background-color: rgba(138, 116, 52, 0.1);
}

.ch-points--none {
    opacity: 0.5;
}

.ch-points__text {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(216, 203, 180);
    margin: 0 0 0 12px;
    padding: 0;
}

.ch-points__value {
    font-size: 20px;
    color: rgb(232, 205, 138);
    margin: 0;
    padding: 0;
}

.ch-stat {
    flex-direction: row;
    align-items: center;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 47, 37, 0.6);
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}

.ch-stat--focused {
    background-color: rgba(138, 116, 52, 0.14);
    border-left-color: rgb(201, 161, 74);
}

.ch-stat__names {
    flex-grow: 1;
}

.ch-stat__name {
    font-size: 17px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
}

.ch-stat__hint {
    font-size: 13px;
    color: rgb(95, 87, 76);
    margin: 2px 0 0 0;
    padding: 0;
}

.ch-stat__value {
    font-size: 20px;
    color: rgb(240, 230, 210);
    margin: 0 12px 0 0;
    padding: 0;
}

.ch-stat__preview {
    min-width: 54px;
    font-size: 15px;
    color: rgb(127, 168, 92);
    -unity-text-align: middle-right;
    margin: 0 12px 0 0;
    padding: 0;
}

.ch-stat__add,
.ch-stat__add:hover,
.ch-stat__add:active {
    width: 34px;
    height: 34px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(232, 205, 138);
    background-color: rgb(28, 23, 19);
    border-width: 1px;
    border-color: rgb(138, 116, 52);
    border-radius: 0;
}

.ch-stat__add:hover {
    border-color: rgb(232, 205, 138);
}

.ch-stat__add:disabled {
    color: rgb(95, 87, 76);
    border-color: rgb(58, 47, 37);
    opacity: 0.5;
}

.ch-tip {
    padding: 12px 16px;
    border-left-width: 2px;
    border-left-color: rgb(138, 116, 52);
    background-color: rgba(138, 116, 52, 0.07);
}

.ch-tip__head {
    font-size: 17px;
    color: rgb(240, 230, 210);
    margin: 0 0 8px 0;
    padding: 0;
}

.ch-tip__text {
    font-size: 15px;
    color: rgb(142, 131, 117);
    white-space: normal;
    margin: 0 0 8px 0;
    padding: 0;
}

.ch-tip__line {
    font-size: 15px;
    color: rgb(216, 203, 180);
    white-space: normal;
    margin: 0 0 3px 0;
    padding: 0;
}

.ch-tip__limit {
    font-size: 15px;
    color: rgb(196, 85, 47);
    margin: 4px 0 0 0;
    padding: 0;
}

/* ---------- skills page (skills.html) ---------- */

.inv__categories {
    align-items: center;
}

.sk-points {
    flex-direction: row;
    align-items: center;
}

.sk-points__text {
    font-size: 15px;
    color: rgb(216, 203, 180);
    margin: 0 8px 0 8px;
    padding: 0;
}

.sk-points__value {
    font-size: 20px;
    color: rgb(232, 205, 138);
    margin: 0;
    padding: 0;
}

.sk-area {
    flex-grow: 1;
    margin-right: 24px;
}

/* The grid is 5 columns of 120 px and 5 rows of 116 px; the lines are drawn on it. */
.sk-tree {
    position: relative;
    width: 600px;
    height: 580px;
    margin-top: 8px;
}

.sk-links {
    position: absolute;
    left: 0;
    top: 0;
    width: 600px;
    height: 580px;
}

.sk-node {
    position: absolute;
    width: 84px;
    height: 84px;
}

.sk-node--locked {
    opacity: 0.55;
}

.sk-node__rank {
    position: absolute;
    bottom: -8px;
    left: 26px;
    width: 32px;
    font-size: 13px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0 2px;
    background-color: rgb(11, 9, 7);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
}

.sk-node__slot {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(15, 13, 11);
    background-color: rgb(201, 161, 74);
    margin: 0;
    padding: 0;
}

.sk-meta {
    color: rgb(138, 116, 52);
}

.sk-slots {
    flex-direction: row;
}

.sk-slot,
.sk-slot:hover,
.sk-slot:active {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    margin: 0 8px 0 0;
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(58, 47, 37);
    border-radius: 0;
}

.sk-slot:hover {
    border-color: rgb(107, 90, 66);
}

.sk-slot--taken {
    border-color: rgb(138, 116, 52);
}

.sk-slot__name {
    font-size: 15px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-left;
    margin: 0 0 0 4px;
    padding: 0;
}

.sk-slot__name--empty {
    color: rgb(95, 87, 76);
}

/* Two long labels do not fit side by side in the 430 px panel: one above the other. */
.sk-actions > .btn {
    margin-top: 8px;
}
