<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Hud.uss" />
    <Style src="../Menu/Options.uss" />
    <Style src="Pause.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="vignette" class="vignette" picking-mode="Ignore" />

        <ui:VisualElement name="conditions" class="conditions" picking-mode="Ignore">
            <ui:VisualElement name="status-bleed" class="chip chip--bleed" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-poison" class="chip chip--poison" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-burn" class="chip chip--burn" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-frost" class="chip chip--frost" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="purse" class="purse" picking-mode="Ignore">
            <ui:VisualElement name="purse-icon" class="purse__icon" picking-mode="Ignore" />
            <ui:Label name="purse-value" class="purse__value" text="0" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="boss" class="boss" picking-mode="Ignore">
            <ui:Label name="boss-name" class="boss__name display" text="Страж Гробниці" picking-mode="Ignore" />
            <ui:VisualElement name="boss-divider" class="boss__divider ornament" picking-mode="Ignore" />
            <ui:VisualElement name="boss-frame" class="bar boss__bar" picking-mode="Ignore">
                <ui:VisualElement name="boss-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="boss-fill" class="bar__fill bar__fill--boss" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement name="boss-mark" class="boss__mark" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="boss__meta" picking-mode="Ignore">
                <ui:Label name="boss-phase" class="boss__phase display" text="Фаза I" picking-mode="Ignore" />
                <ui:Label name="boss-value" class="boss__value" text="" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="resources" class="resources" picking-mode="Ignore">
            <!-- design/ui/tutorial/tutorial.html, frames 1-2: flasks read by shape, not by number. -->
            <ui:VisualElement name="flasks" class="flasks" picking-mode="Ignore">
                <ui:VisualElement name="flask-row" class="flasks__row" picking-mode="Ignore" />
                <ui:Label class="key flasks__key" text="R" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="resources__head" picking-mode="Ignore">
                <ui:Label class="resources__label display" text="Здоров'я" picking-mode="Ignore" />
                <ui:Label name="hp-value" class="resources__value" text="" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hp-frame" class="bar bar--hp" picking-mode="Ignore">
                <ui:VisualElement name="hp-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="hp-fill" class="bar__fill bar__fill--hp" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="mana-frame" class="bar bar--mana" picking-mode="Ignore">
                <ui:VisualElement name="mana-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="mana-fill" class="bar__fill bar__fill--mana" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="stamina-frame" class="bar bar--stamina" picking-mode="Ignore">
                <ui:VisualElement name="stamina-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="stamina-fill" class="bar__fill bar__fill--stamina" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loadout" class="loadout" picking-mode="Ignore">
            <ui:VisualElement class="loadout__group" picking-mode="Ignore">
                <ui:Label class="loadout__caption display" text="Зброя" picking-mode="Ignore" />
                <ui:VisualElement class="loadout__row" picking-mode="Ignore">
                    <ui:VisualElement name="slot-weapon" class="slot slot--large" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="F" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="loadout__group" picking-mode="Ignore">
                <ui:Label class="loadout__caption display" text="Уміння" picking-mode="Ignore" />
                <ui:VisualElement class="loadout__row" picking-mode="Ignore">
                    <ui:VisualElement name="slot-skill-0" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="1" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-skill-1" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="2" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="loadout__group" picking-mode="Ignore">
                <ui:Label class="loadout__caption display" text="Закляття" picking-mode="Ignore" />
                <ui:VisualElement class="loadout__row" picking-mode="Ignore">
                    <ui:VisualElement name="slot-spell-0" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="3" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-spell-1" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="4" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-spell-2" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="5" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
            <ui:Label class="prompt__glyph" text="E" picking-mode="Ignore" />
            <ui:Label name="prompt-text" class="prompt__text" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="zone-title" class="zone-title" picking-mode="Ignore">
            <ui:VisualElement class="zone-title__rule ornament" picking-mode="Ignore" />
            <ui:Label name="zone-title-text" class="zone-title__text display" text="" picking-mode="Ignore" />
            <ui:VisualElement class="zone-title__rule ornament" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />

        <ui:VisualElement name="death" class="death" picking-mode="Ignore">
            <ui:Label class="death__text display" text="ВИ ЗАГИНУЛИ" picking-mode="Ignore" />
            <ui:VisualElement class="death__rule ornament" picking-mode="Ignore" />
            <ui:Label class="death__sub" text="Повернення до вівтаря" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- design/ui/menus/menus.html, frame 4: the pause over the live, frozen game. -->
        <ui:VisualElement name="pause" class="pause">
            <ui:VisualElement name="pause-panel" class="pause__panel">
                <ui:VisualElement class="pause__inset" picking-mode="Ignore" />
                <ui:VisualElement class="pause__header" picking-mode="Ignore">
                    <ui:Label class="pause__title display" text="ПАУЗА" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="pause__body">
                    <ui:Button name="pause-resume" class="btn btn--primary"><ui:Label class="btn__text display" text="ПРОДОВЖИТИ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-equipment" class="btn"><ui:Label class="btn__text display" text="СПОРЯДЖЕННЯ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-character" class="btn"><ui:Label class="btn__text display" text="ПЕРСОНАЖ" picking-mode="Ignore" /><ui:VisualElement name="pause-character-pip" class="pip" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-skills" class="btn"><ui:Label class="btn__text display" text="УМІННЯ" picking-mode="Ignore" /><ui:VisualElement name="pause-skills-pip" class="pip" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-options" class="btn"><ui:Label class="btn__text display" text="НАЛАШТУВАННЯ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-controls" class="btn"><ui:Label class="btn__text display" text="КЕРУВАННЯ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-main-menu" class="btn btn--danger btn--last"><ui:Label class="btn__text display" text="ДО ГОЛОВНОГО МЕНЮ" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- design/ui/tutorial/tutorial.html, frame 4: the controls, view only. -->
            <ui:VisualElement name="controls-panel" class="controls">
                <ui:VisualElement class="pause__inset" picking-mode="Ignore" />
                <ui:VisualElement class="pause__header" picking-mode="Ignore">
                    <ui:Label class="controls__title display" text="КЕРУВАННЯ" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="controls__body" picking-mode="Ignore">
                    <ui:VisualElement class="controls__cols" picking-mode="Ignore">
                    <ui:VisualElement class="controls__col" picking-mode="Ignore">
                        <ui:VisualElement class="controls__head" picking-mode="Ignore">
                            <ui:Label class="controls__head-name" text="ДІЯ" picking-mode="Ignore" />
                            <ui:Label class="controls__head-col" text="КЛАВІАТУРА" picking-mode="Ignore" />
                            <ui:Label class="controls__head-col" text="ГЕЙМПАД" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="controls__section" text="РУХ" picking-mode="Ignore" />
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Рух" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="A" picking-mode="Ignore" /><ui:Label class="key" text="D" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="keys__text" text="лівий стік" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Стрибок" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="Space" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Біг по стіні" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="keys__text" text="тримати" picking-mode="Ignore" /><ui:Label class="key" text="Space" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="keys__text" text="тримати" picking-mode="Ignore" /><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Ривок" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="L" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="RT" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label class="controls__section" text="БІЙ" picking-mode="Ignore" />
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Атака" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="J" picking-mode="Ignore" /><ui:Label class="keys__text" text="ЛКМ" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="X" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Важка атака" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="K" picking-mode="Ignore" /><ui:Label class="keys__text" text="ПКМ" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="RB" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Блок / парирування" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="Q" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="LB" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Фляга" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="R" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="keys__text" text="хрестовина ▲" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls__col controls__col--right" picking-mode="Ignore">
                        <ui:VisualElement class="controls__head" picking-mode="Ignore">
                            <ui:Label class="controls__head-name" text="ДІЯ" picking-mode="Ignore" />
                            <ui:Label class="controls__head-col" text="КЛАВІАТУРА" picking-mode="Ignore" />
                            <ui:Label class="controls__head-col" text="ГЕЙМПАД" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="controls__section" text="УМІННЯ Й ЗАКЛЯТТЯ" picking-mode="Ignore" />
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Уміння 1 / 2" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="1" picking-mode="Ignore" /><ui:Label class="key" text="2" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="LT" picking-mode="Ignore" /><ui:Label class="keys__text" text="+" picking-mode="Ignore" /><ui:Label class="key key--pad" text="LB" picking-mode="Ignore" /><ui:Label class="key key--pad" text="RB" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Закляття 1–3" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="3" picking-mode="Ignore" /><ui:Label class="key" text="4" picking-mode="Ignore" /><ui:Label class="key" text="5" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="LT" picking-mode="Ignore" /><ui:Label class="keys__text" text="+" picking-mode="Ignore" /><ui:Label class="key key--pad" text="X" picking-mode="Ignore" /><ui:Label class="key key--pad" text="Y" picking-mode="Ignore" /><ui:Label class="key key--pad" text="B" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Зміна зброї" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="F" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="keys__text" text="хрестовина ◀" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label class="controls__section" text="ІНШЕ" picking-mode="Ignore" />
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Взаємодія" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="E" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="Y" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Спорядження" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="I" picking-mode="Ignore" /><ui:Label class="key" text="Tab" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="Select" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Карта" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="M" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="keys__text" text="хрестовина ▼" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row" picking-mode="Ignore">
                            <ui:Label class="control-row__name" text="Пауза" picking-mode="Ignore" />
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key" text="Esc" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="keys" picking-mode="Ignore"><ui:Label class="key key--pad" text="Start" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="controls-back" class="controls__back">
                        <ui:Label class="key" text="Esc" picking-mode="Ignore" /><ui:Label class="key key--pad" text="B" picking-mode="Ignore" /><ui:Label class="controls__back-text" text="Назад" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="options-panel" class="options">
                <ui:Label class="options__title display" text="Налаштування" />
                <ui:VisualElement class="options__rule ornament" picking-mode="Ignore" />
                <ui:Slider name="opt-master" class="option" label="Гучність" low-value="0" high-value="1" />
                <ui:Slider name="opt-effects" class="option" label="Ефекти" low-value="0" high-value="1" />
                <ui:Slider name="opt-shake" class="option" label="Тремтіння камери" low-value="0" high-value="1" />
                <ui:Slider name="opt-flash" class="option" label="Спалахи" low-value="0" high-value="1" />
                <ui:Slider name="opt-hitstop" class="option" label="Зупинка при ударі" low-value="0" high-value="1" />
                <ui:Button name="options-back" class="menu-button menu-button--small display" text="Назад" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- design/ui/tutorial/tutorial.html, frame 5: a moment, not a screen; the game waits under it. -->
        <ui:VisualElement name="ability-card" class="ability">
            <ui:VisualElement class="ability__card">
                <ui:VisualElement class="pause__inset" picking-mode="Ignore" />
                <ui:Label class="ability__kicker display" text="ОТРИМАНО ЗДІБНІСТЬ" picking-mode="Ignore" />
                <ui:Label name="ability-name" class="ability__name display" text="" picking-mode="Ignore" />
                <ui:VisualElement class="ability__rule" picking-mode="Ignore" />
                <ui:Label name="ability-text" class="ability__text" text="" picking-mode="Ignore" />
                <ui:VisualElement class="ability__how" picking-mode="Ignore">
                    <ui:Label name="ability-how" class="ability__how-text" text="" picking-mode="Ignore" />
                    <ui:Label name="ability-key" class="key" text="" picking-mode="Ignore" />
                    <ui:Label class="ability__or" text="або" picking-mode="Ignore" />
                    <ui:Label name="ability-pad" class="key key--pad" text="" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="ability-continue" class="ability__continue">
                    <ui:Label class="key" text="E" picking-mode="Ignore" /><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /><ui:Label class="ability__continue-text" text="Продовжити" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
