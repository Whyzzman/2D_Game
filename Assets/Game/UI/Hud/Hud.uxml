                </ui:VisualElement>
                <ui:VisualElement class="inv__footer" picking-mode="Ignore">
                    <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="E" picking-mode="Ignore" /><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /><ui:Label class="hint__text" text="Купити" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="↑↓" picking-mode="Ignore" /><ui:Label class="hint__text" text="Обрати" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Esc" picking-mode="Ignore" /><ui:Label class="key key--pad" text="B" picking-mode="Ignore" /><ui:Label class="hint__text" text="Піти" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="shop-rumour" class="shop__rumour">
                <ui:Label class="section-label display" text="ЧУТКА" picking-mode="Ignore" />
                <ui:Label name="shop-rumour-quote" class="shop__rumour-quote" text="" picking-mode="Ignore" />
                <ui:Label name="shop-rumour-where" class="shop__rumour-where" text="" picking-mode="Ignore" />
                <ui:Button name="shop-rumour-ok" class="btn btn--primary btn--last shop__rumour-ok"><ui:Label class="btn__text display" text="ДАЛІ" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- design/ui/menus/menus.html, frame 4: the pause over the live, frozen game. -->
        <ui:VisualElement name="pause" class="pause">
            <ui:VisualElement name="pause-panel" class="pause__panel">
                <ui:VisualElement class="pause__inset" picking-mode="Ignore" />
                <ui:VisualElement class="pause__header" picking-mode="Ignore">
                    <ui:Label class="pause__title display" text="ПАУЗА" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="pause__body">
                    <ui:Button name="pause-resume" class="btn btn--primary"><ui:Label class="btn__text display" text="ПРОДОВЖИТИ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-map" class="btn"><ui:Label class="btn__text display" text="КАРТА" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-equipment" class="btn"><ui:Label class="btn__text display" text="СПОРЯДЖЕННЯ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-character" class="btn"><ui:Label class="btn__text display" text="ПЕРСОНАЖ" picking-mode="Ignore" /><ui:VisualElement name="pause-character-pip" class="pip" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-skills" class="btn"><ui:Label class="btn__text display" text="УМІННЯ" picking-mode="Ignore" /><ui:VisualElement name="pause-skills-pip" class="pip" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-options" class="btn"><ui:Label class="btn__text display" text="НАЛАШТУВАННЯ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-controls" class="btn"><ui:Label class="btn__text display" text="КЕРУВАННЯ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="pause-main-menu" class="btn btn--danger btn--last"><ui:Label class="btn__text display" text="ДО ГОЛОВНОГО МЕНЮ" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- design/ui/controls/controls.html: the controls, now changeable; ControlsPanel builds the rows. -->
            <ui:VisualElement name="controls-panel" class="controls" />

            <ui:VisualElement name="options-panel" class="options">
                <ui:Label class="options__title display" text="Налаштування" />
                <ui:VisualElement class="options__rule ornament" picking-mode="Ignore" />
                <ui:Slider name="opt-master" class="option" label="Гучність" low-value="0" high-value="1" />
                <ui:Slider name="opt-effects" class="option" label="Ефекти" low-value="0" high-value="1" />
                <ui:Slider name="opt-shake" class="option" label="Тремтіння камери" low-value="0" high-value="1" />
                <ui:Slider name="opt-flash" class="option" label="Спалахи" low-value="0" high-value="1" />
                <ui:Slider name="opt-hitstop" class="option" label="Зупинка при ударі" low-value="0" high-value="1" />
                <ui:Toggle name="opt-post" class="option option--toggle" label="Ефекти зображення" value="true" />
                <ui:Button name="options-back" class="menu-button menu-button--small display" text="Назад" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- design/ui/tutorial/tutorial.html, frame 5: a moment, not a screen; the game waits under it. -->
        <ui:VisualElement name="ability-card" class="ability">
            <ui:VisualElement class="ability__card">
                <ui:VisualElement class="pause__inset" picking-mode="Ignore" />
                <ui:Label class="ability__kicker display" text="ОТРИМАНО ЗДІБНІСТЬ" picking-mode="Ignore" />
                <ui:Label name="ability-name" class="ability__name display" text="" picking-mode="Ignore" />
                <ui:VisualElement class="ability__rule" picking-mode="Ignore" />
                <ui:Label name="ability-text" class="ability__text" text="" picking-mode="Ignore" />
                <ui:VisualElement class="ability__how" picking-mode="Ignore">
                    <ui:Label name="ability-how" class="ability__how-text" text="" picking-mode="Ignore" />
                    <ui:Label name="ability-key" class="key" text="" picking-mode="Ignore" />
                    <ui:Label class="ability__or" text="або" picking-mode="Ignore" />
                    <ui:Label name="ability-pad" class="key key--pad" text="" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="ability-continue" class="ability__continue">
                    <ui:Label class="key" text="E" picking-mode="Ignore" /><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /><ui:Label class="ability__continue-text" text="Продовжити" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- design/ui/ending/ending.html frames 3-5: the ending, the credits, the summary. Last, so over all. -->
        <ui:VisualElement name="end" class="end">
            <ui:VisualElement class="end__lines" picking-mode="Ignore">
                <ui:Label name="end-line-0" class="end__line display" text="" picking-mode="Ignore" />
                <ui:Label name="end-line-1" class="end__line display" text="" picking-mode="Ignore" />
                <ui:Label name="end-line-2" class="end__line display" text="" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="end-credits" class="end__credits" picking-mode="Ignore">
                <ui:VisualElement name="end-roll" class="end__roll" picking-mode="Ignore">
                    <ui:Label class="end__credits-title display" text="Тінь Забутого Королівства" picking-mode="Ignore" />
                    <ui:Label class="end__credits-role" text="ГРА" picking-mode="Ignore" />
                    <ui:Label class="end__credits-name display" text="—" picking-mode="Ignore" />
                    <ui:Label class="end__credits-role" text="КОД І ДИЗАЙН" picking-mode="Ignore" />
                    <ui:Label class="end__credits-name display" text="—" picking-mode="Ignore" />
                    <ui:Label class="end__credits-role" text="АРТ І ЗВУК" picking-mode="Ignore" />
                    <ui:Label class="end__credits-name display" text="тимчасові, процедурні" picking-mode="Ignore" />
                    <ui:Label class="end__credits-name display" text="Дякуємо, що грали" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="end__summary" picking-mode="Ignore">
                <ui:Label class="end__summary-title display" text="ПІДСУМКИ" picking-mode="Ignore" />
                <ui:VisualElement class="end__summary-body" picking-mode="Ignore">
                    <ui:VisualElement class="end__row" picking-mode="Ignore"><ui:Label class="end__row-name" text="Час" picking-mode="Ignore" /><ui:Label name="end-time" class="end__row-value" text="" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="end__row" picking-mode="Ignore"><ui:Label class="end__row-name" text="Смертей" picking-mode="Ignore" /><ui:Label name="end-deaths" class="end__row-value" text="" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="end__row" picking-mode="Ignore"><ui:Label class="end__row-name" text="Карта" picking-mode="Ignore" /><ui:Label name="end-map" class="end__row-value" text="" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="end__row" picking-mode="Ignore"><ui:Label class="end__row-name" text="Убито ворогів" picking-mode="Ignore" /><ui:Label name="end-kills" class="end__row-value" text="" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="end__row" picking-mode="Ignore"><ui:Label class="end__row-name" text="Секретів" picking-mode="Ignore" /><ui:Label name="end-secrets" class="end__row-value" text="" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="end__row" picking-mode="Ignore"><ui:Label class="end__row-name" text="Рівень героя" picking-mode="Ignore" /><ui:Label name="end-level" class="end__row-value" text="" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Button name="end-continue" class="btn btn--primary end__continue"><ui:Label class="btn__text display" text="ПРОДОВЖИТИ" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label class="end__skip" text="E — утримати, щоб пропустити" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
