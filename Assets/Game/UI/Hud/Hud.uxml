                    <ui:Button name="shrine-travel" class="btn"><ui:Label class="btn__text display" text="МАНДРУВАТИ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="shrine-character" class="btn"><ui:Label class="btn__text display" text="ПЕРСОНАЖ" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="shrine-skills" class="btn"><ui:Label class="btn__text display" text="УМІННЯ" picking-mode="Ignore" /></ui:Button>
