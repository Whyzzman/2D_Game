<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Hud.uss" />
    <Style src="../Menu/Options.uss" />
    <Style src="Pause.uss" />
    <Style src="../Menu/Controls.uss" />
    <Style src="Inventory.uss" />
    <Style src="Map.uss" />
    <Style src="Npc.uss" />
    <Style src="Story.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="vignette" class="vignette" picking-mode="Ignore" />

        <ui:VisualElement name="conditions" class="conditions" picking-mode="Ignore">
            <ui:VisualElement name="status-bleed" class="chip chip--bleed" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-poison" class="chip chip--poison" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-burn" class="chip chip--burn" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-frost" class="chip chip--frost" picking-mode="Ignore">
                <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                <ui:VisualElement class="chip__meter" picking-mode="Ignore"><ui:VisualElement class="chip__meter-fill" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="purse" class="purse" picking-mode="Ignore">
            <ui:VisualElement name="purse-icon" class="purse__icon" picking-mode="Ignore" />
            <ui:Label name="purse-value" class="purse__value" text="0" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="boss" class="boss" picking-mode="Ignore">
            <ui:Label name="boss-name" class="boss__name display" text="Страж Гробниці" picking-mode="Ignore" />
            <ui:VisualElement name="boss-divider" class="boss__divider ornament" picking-mode="Ignore" />
            <ui:VisualElement name="boss-frame" class="bar boss__bar" picking-mode="Ignore">
                <ui:VisualElement name="boss-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="boss-fill" class="bar__fill bar__fill--boss" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement name="boss-mark" class="boss__mark" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="boss__meta" picking-mode="Ignore">
                <ui:Label name="boss-phase" class="boss__phase display" text="Фаза I" picking-mode="Ignore" />
                <ui:Label name="boss-value" class="boss__value" text="" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="resources" class="resources" picking-mode="Ignore">
            <!-- design/ui/tutorial/tutorial.html, frames 1-2: flasks read by shape, not by number. -->
            <ui:VisualElement name="flasks" class="flasks" picking-mode="Ignore">
                <ui:VisualElement name="flask-row" class="flasks__row" picking-mode="Ignore" />
                <ui:Label class="key flasks__key" text="R" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="resources__head" picking-mode="Ignore">
                <ui:Label class="resources__label display" text="Здоров'я" picking-mode="Ignore" />
                <ui:Label name="hp-value" class="resources__value" text="" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hp-frame" class="bar bar--hp" picking-mode="Ignore">
                <ui:VisualElement name="hp-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="hp-fill" class="bar__fill bar__fill--hp" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="mana-frame" class="bar bar--mana" picking-mode="Ignore">
                <ui:VisualElement name="mana-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="mana-fill" class="bar__fill bar__fill--mana" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="stamina-frame" class="bar bar--stamina" picking-mode="Ignore">
                <ui:VisualElement name="stamina-loss" class="bar__loss" picking-mode="Ignore" />
                <ui:VisualElement name="stamina-fill" class="bar__fill bar__fill--stamina" picking-mode="Ignore" />
                <ui:VisualElement class="bar__sheen" picking-mode="Ignore" />
                <ui:VisualElement class="bar__frame" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loadout" class="loadout" picking-mode="Ignore">
            <ui:VisualElement class="loadout__group" picking-mode="Ignore">
                <ui:Label class="loadout__caption display" text="Зброя" picking-mode="Ignore" />
                <ui:VisualElement class="loadout__row" picking-mode="Ignore">
                    <ui:VisualElement name="slot-weapon" class="slot slot--large" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="F" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="loadout__group" picking-mode="Ignore">
                <ui:Label class="loadout__caption display" text="Уміння" picking-mode="Ignore" />
                <ui:VisualElement class="loadout__row" picking-mode="Ignore">
                    <ui:VisualElement name="slot-skill-0" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="1" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-skill-1" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="2" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="loadout__group" picking-mode="Ignore">
                <ui:Label class="loadout__caption display" text="Закляття" picking-mode="Ignore" />
                <ui:VisualElement class="loadout__row" picking-mode="Ignore">
                    <ui:VisualElement name="slot-spell-0" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="3" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-spell-1" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="4" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="slot-spell-2" class="slot" picking-mode="Ignore">
                        <ui:VisualElement class="slot__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot__timer" picking-mode="Ignore" />
                        <ui:VisualElement class="slot__frame" picking-mode="Ignore" />
                        <ui:Label class="slot__key" text="5" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
            <ui:Label class="prompt__glyph" text="E" picking-mode="Ignore" />
            <ui:Label name="prompt-text" class="prompt__text" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="zone-title" class="zone-title" picking-mode="Ignore">
            <ui:VisualElement class="zone-title__rule ornament" picking-mode="Ignore" />
            <ui:Label name="zone-title-text" class="zone-title__text display" text="" picking-mode="Ignore" />
            <ui:VisualElement class="zone-title__rule ornament" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- design/ui/ending/ending.html frame 2: the words of a stone being read. -->
        <ui:VisualElement name="ins" class="ins" picking-mode="Ignore">
            <ui:Label name="ins-text" class="ins__text display" text="" picking-mode="Ignore" />
            <ui:Label class="ins__hint" text="НАПИС НА КАМЕНІ" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- design/ui/boss-title/boss-title.html: the boss's name as its arena seals. -->
        <ui:VisualElement name="boss-title" class="boss-title" picking-mode="Ignore">
            <ui:Label name="boss-title-epithet" class="boss-title__epithet display" text="" picking-mode="Ignore" />
            <ui:Label name="boss-title-name" class="boss-title__name display" text="" picking-mode="Ignore" />
            <ui:VisualElement name="boss-title-rule" class="boss-title__rule ornament" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />

        <ui:VisualElement name="death" class="death" picking-mode="Ignore">
            <ui:Label class="death__text display" text="ВИ ЗАГИНУЛИ" picking-mode="Ignore" />
            <ui:VisualElement class="death__rule ornament" picking-mode="Ignore" />
            <ui:Label class="death__sub" text="Повернення до вівтаря" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- design/ui/inventory/inventory.html and equipment/equipment.html: one window, pages on top. -->
        <ui:VisualElement name="inventory" class="inv">
            <ui:VisualElement class="inv__panel">
                <ui:VisualElement class="pause__inset" picking-mode="Ignore" />
                <ui:VisualElement class="inv__header">
                    <ui:Label name="inv-title" class="inv__title display" text="СПОРЯДЖЕННЯ" picking-mode="Ignore" />
                    <ui:VisualElement class="inv__pages">
                        <ui:Button name="inv-page-map" class="tab"><ui:Label class="tab__text display" text="КАРТА" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-items" class="tab"><ui:Label class="tab__text display" text="СПОРЯДЖЕННЯ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-equipment" class="tab"><ui:Label class="tab__text display" text="ЕКІПІРУВАННЯ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-character" class="tab"><ui:Label class="tab__text display" text="ПЕРСОНАЖ" picking-mode="Ignore" /><ui:VisualElement name="inv-character-pip" class="pip" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-skills" class="tab"><ui:Label class="tab__text display" text="УМІННЯ" picking-mode="Ignore" /><ui:VisualElement name="inv-skills-pip" class="pip" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-spells" class="tab"><ui:Label class="tab__text display" text="ЗАКЛЯТТЯ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-people" class="tab"><ui:Label class="tab__text display" text="ЛЮДИ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-page-bestiary" class="tab"><ui:Label class="tab__text display" text="БЕСТІАРІЙ" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="inv__purse" picking-mode="Ignore">
                        <ui:VisualElement class="inv__coin" picking-mode="Ignore" />
                        <ui:Label name="inv-purse" class="inv__purse-text" text="0" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- inventory.html: the categories, the grid and the item panel. -->
                <ui:VisualElement name="inv-items" class="inv__page">
                    <ui:VisualElement class="inv__categories">
                        <ui:Button name="inv-cat-0" class="tab"><ui:Label class="tab__text display" text="ЗБРОЯ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-cat-1" class="tab"><ui:Label class="tab__text display" text="БРОНЯ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-cat-2" class="tab"><ui:Label class="tab__text display" text="ПРИКРАСИ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-cat-3" class="tab"><ui:Label class="tab__text display" text="ВИТРАТНЕ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-cat-4" class="tab"><ui:Label class="tab__text display" text="МАТЕРІАЛИ" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="inv-cat-5" class="tab"><ui:Label class="tab__text display" text="КЛЮЧОВІ" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="inv__body">
                        <ui:ScrollView name="inv-grid" class="inv__grid-scroll" />
                        <ui:VisualElement class="detail">
                            <ui:Label name="inv-empty" class="detail__empty" text="Тут поки нічого немає." picking-mode="Ignore" />
                            <ui:VisualElement name="inv-detail" class="detail__content">
                                <ui:Label name="inv-name" class="detail__name display" text="" picking-mode="Ignore" />
                                <ui:Label name="inv-type" class="detail__type" text="" picking-mode="Ignore" />
                                <ui:Label name="inv-desc" class="detail__desc" text="" picking-mode="Ignore" />
                                <ui:VisualElement name="inv-compare-section" class="detail__section" picking-mode="Ignore">
                                    <ui:Label name="inv-compare-title" class="section-label display" text="ПОРІВНЯННЯ З ЕКІПІРОВАНИМ" picking-mode="Ignore" />
                                    <ui:VisualElement name="inv-compare-head" class="compare__head" picking-mode="Ignore">
                                        <ui:Label class="compare__head-text" text="ХАРАКТЕРИСТИКА" picking-mode="Ignore" />
                                        <ui:Label name="inv-compare-names" class="compare__head-text compare__val" text="" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="inv-compare" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-effects-section" class="detail__section" picking-mode="Ignore">
                                    <ui:Label class="section-label display" text="ДІЯ" picking-mode="Ignore" />
                                    <ui:VisualElement name="inv-effects" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-req-section" class="detail__section" picking-mode="Ignore">
                                    <ui:Label class="section-label display" text="ВИМОГИ" picking-mode="Ignore" />
                                    <ui:VisualElement name="inv-req" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                <ui:VisualElement class="detail__actions">
                                    <ui:Button name="inv-equip" class="btn btn--primary btn--last"><ui:Label class="btn__text display" text="ЕКІПІРУВАТИ" picking-mode="Ignore" /></ui:Button>
                                </ui:VisualElement>
                                <ui:Label name="inv-problem" class="detail__problem" text="" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="inv__footer" picking-mode="Ignore">
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Z" picking-mode="Ignore" /><ui:Label class="key" text="C" picking-mode="Ignore" /><ui:Label class="key key--pad" text="LT" picking-mode="Ignore" /><ui:Label class="key key--pad" text="RT" picking-mode="Ignore" /><ui:Label class="hint__text" text="Категорії" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Q" picking-mode="Ignore" /><ui:Label class="key" text="E" picking-mode="Ignore" /><ui:Label class="key key--pad" text="LB" picking-mode="Ignore" /><ui:Label class="key key--pad" text="RB" picking-mode="Ignore" /><ui:Label class="hint__text" text="Сторінки" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Enter" picking-mode="Ignore" /><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /><ui:Label class="hint__text" text="Екіпірувати" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Esc" picking-mode="Ignore" /><ui:Label class="key key--pad" text="B" picking-mode="Ignore" /><ui:Label class="hint__text" text="Назад" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                        <ui:Label name="inv-count" class="hint__text" text="" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- equipment.html: the slots, what fits the chosen one, what the character adds up to. -->
                <ui:VisualElement name="inv-equipment" class="inv__page">
                    <ui:VisualElement class="inv__body">
                        <ui:VisualElement class="inv-loadout">
                            <ui:Label class="section-label display" text="ЗБРОЯ" picking-mode="Ignore" />
                            <ui:VisualElement name="eq-group-0" class="inv-loadout__group" />
                            <ui:Label class="section-label display" text="БРОНЯ" picking-mode="Ignore" />
                            <ui:VisualElement name="eq-group-1" class="inv-loadout__group" />
                            <ui:Label class="section-label display" text="ПРИКРАСИ" picking-mode="Ignore" />
                            <ui:VisualElement name="eq-group-2" class="inv-loadout__group" />
                        </ui:VisualElement>
                        <ui:VisualElement class="filtered">
                            <ui:Label class="section-label display" text="ПРИДАТНЕ ДЛЯ СЛОТУ" picking-mode="Ignore" />
                            <ui:Label name="eq-note" class="filtered__note" text="" picking-mode="Ignore" />
                            <ui:ScrollView name="eq-list" class="filtered__list" />
                            <ui:VisualElement class="filtered__actions">
                                <ui:Button name="eq-equip" class="btn btn--primary btn--last"><ui:Label class="btn__text display" text="ЕКІПІРУВАТИ" picking-mode="Ignore" /></ui:Button>
                                <ui:Button name="eq-unequip" class="btn btn--last"><ui:Label class="btn__text display" text="ЗНЯТИ" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                            <ui:Label name="eq-problem" class="detail__problem" text="" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="derived" picking-mode="Ignore">
                            <ui:Label class="section-label display" text="ПОХІДНІ ХАРАКТЕРИСТИКИ" picking-mode="Ignore" />
                            <ui:VisualElement name="eq-stats" picking-mode="Ignore" />
                            <ui:Label class="section-label derived__load-label display" text="НАВАНТАЖЕННЯ" picking-mode="Ignore" />
                            <ui:VisualElement class="load" picking-mode="Ignore">
                                <ui:VisualElement name="eq-load-fill" class="load__fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="eq-load-value" class="load__value" text="" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="inv__footer" picking-mode="Ignore">
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Enter" picking-mode="Ignore" /><ui:Label class="key key--pad" text="A" picking-mode="Ignore" /><ui:Label class="hint__text" text="Екіпірувати" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="X" picking-mode="Ignore" /><ui:Label class="key key--pad" text="X" picking-mode="Ignore" /><ui:Label class="hint__text" text="Зняти" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="↕" picking-mode="Ignore" /><ui:Label class="key" text="↔" picking-mode="Ignore" /><ui:Label class="hint__text" text="Слот і список" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Q" picking-mode="Ignore" /><ui:Label class="key" text="E" picking-mode="Ignore" /><ui:Label class="key key--pad" text="LB" picking-mode="Ignore" /><ui:Label class="key key--pad" text="RB" picking-mode="Ignore" /><ui:Label class="hint__text" text="Сторінки" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="hint" picking-mode="Ignore"><ui:Label class="key" text="Esc" picking-mode="Ignore" /><ui:Label class="key key--pad" text="B" picking-mode="Ignore" /><ui:Label class="hint__text" text="Назад" picking-mode="Ignore" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- character.html: level, the attributes, what a point gives, the derived numbers. -->
                <ui:VisualElement name="inv-character" class="inv__page">
                    <ui:VisualElement class="inv__body">
                        <ui:VisualElement class="ch-col">
                            <ui:VisualElement class="ch-level" picking-mode="Ignore">
                                <ui:Label name="ch-level" class="ch-level__num display" text="1" picking-mode="Ignore" />
                                <ui:VisualElement class="ch-level__side" picking-mode="Ignore">
                                    <ui:VisualElement class="ch-level__row" picking-mode="Ignore">
                                        <ui:Label class="ch-level__label display" text="РІВЕНЬ" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:Label name="ch-xp" class="ch-level__xp" text="" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="load ch-xp-bar" picking-mode="Ignore">
                                        <ui:VisualElement name="ch-xp-fill" class="load__fill ch-xp-fill" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="ch-points" class="ch-points" picking-mode="Ignore">
                                <ui:VisualElement class="pip pip--visible" picking-mode="Ignore" />
                                <ui:Label class="ch-points__text" text="Нерозподілених очок" picking-mode="Ignore" />
                                <ui:Label name="ch-points-value" class="ch-points__value display" text="0" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="ch-stats" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ch-col" picking-mode="Ignore">
                            <ui:Label name="ch-tip-title" class="section-label display" text="" picking-mode="Ignore" />
                            <ui:VisualElement class="ch-tip" picking-mode="Ignore">
                                <ui:Label name="ch-tip-head" class="ch-tip__head display" text="" picking-mode="Ignore" />
                                <ui:Label name="ch-tip-text" class="ch-tip__text" text="" picking-mode="Ignore" />
                                <ui:VisualElement name="ch-tip-list" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label class="section-label ch-gap display" text="ПОХІДНІ ХАРАКТЕРИСТИКИ" picking-mode="Ignore" />
                            <ui:VisualElement name="ch-derived" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ch-col ch-col--side" picking-mode="Ignore">
                            <ui:Label class="section-label display" text="СТАН" picking-mode="Ignore" />
                            <ui:VisualElement name="ch-state" picking-mode="Ignore" />
                            <ui:Label class="section-label ch-gap display" text="ОПІР СТАНАМ" picking-mode="Ignore" />
                            <ui:VisualElement name="ch-resist" picking-mode="Ignore" />
