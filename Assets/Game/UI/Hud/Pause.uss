/*
 * The pause menu, from design/ui/menus/menus.html (frame 4) and design/ui/_shared/ui.css:
 * a scrim over the frozen game, one royal panel 520 px wide, a column of buttons.
 * USS has no gradients, box shadows or text-transform, so the button gradient is its middle
 * tone, the focus glow is a gold border on a faint gold wash, and the labels are upper case
 * in the markup.
 */

.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

.pause--open {
    display: flex;
}

/* The settings take the place of the list rather than stacking over it. */
.pause--options > .pause__panel {
    display: none;
}

.pause__panel {
    width: 520px;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 2px;
}

.pause__inset {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    border-width: 1px;
    border-color: rgba(138, 116, 52, 0.35);
}

.pause__header {
    padding: 12px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
    background-color: rgba(138, 116, 52, 0.1);
}

.pause__title {
    font-size: 20px;
    letter-spacing: 1px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
}

.pause__body {
    padding: 24px;
}

/* The buttons (.btn) and the points diamond (.pip) are in Menu/Options.uss, shared with the title screen. */

/* ---------- input glyphs (ui.css .glyph): a key never appears as plain text ---------- */

.key {
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    margin: 0 4px 0 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 230, 210);
    background-color: rgb(42, 36, 30);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-bottom-width: 2px;
    border-bottom-color: rgb(11, 9, 7);
    border-radius: 2px;
}

.key--pad {
    border-radius: 13px;
    background-color: rgb(50, 43, 32);
}

/* ---------- controls (tutorial.html, frame 4): view only ---------- */

.controls {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1020px;
    translate: -50% -50%;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 2px;
    display: none;
}

.controls--open {
    display: flex;
}

.pause--controls > .pause__panel {
    display: none;
}

.controls__title {
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(240, 230, 210);
    margin: 0;
    padding: 0;
}

.controls__body {
    padding: 24px 32px 32px 32px;
}

.controls__cols {
    flex-direction: row;
}

.controls__col {
    flex-grow: 1;
    flex-basis: 0;
}

.controls__col--right {
    margin-left: 48px;
}

.controls__head {
    flex-direction: row;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 47, 37);
}

.controls__head-name,
.controls__head-col,
.controls__section {
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(138, 116, 52);
    margin: 0;
    padding: 0;
}

.controls__head-name {
    flex-grow: 1;
}

.controls__head-col {
    width: 130px;
}

.controls__section {
    margin: 16px 0 4px 0;
    color: rgb(95, 87, 76);
}

.control-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 47, 37, 0.5);
}

.control-row__name {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(216, 203, 180);
    margin: 0;
    padding: 0;
}

.keys {
    width: 130px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.keys__text {
    font-size: 12px;
    color: rgb(95, 87, 76);
    margin: 0 4px 0 0;
    padding: 0;
}

.controls__back {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin: 24px 0 0 0;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.controls__back:hover > .controls__back-text,
.controls__back--focused > .controls__back-text {
    color: rgb(232, 205, 138);
}

.controls__back-text {
    font-size: 15px;
    color: rgb(142, 131, 117);
    margin: 0 0 0 4px;
    padding: 0;
}

/* ---------- ability card (tutorial.html, frame 5): the game waits under it ---------- */

.ability {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.78);
    align-items: center;
    justify-content: center;
    display: none;
}

.ability--open {
    display: flex;
}

.ability__card {
    width: 720px;
    padding: 32px 48px;
    align-items: center;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 2px;
}

.ability__kicker {
    font-size: 13px;
    letter-spacing: 4px;
    color: rgb(138, 116, 52);
    margin: 0;
    padding: 0;
}

.ability__name {
    margin: 12px 0 8px 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
}

.ability__rule {
    width: 60%;
    height: 1px;
    margin: 16px 0;
    background-color: rgb(138, 116, 52);
}

.ability__text {
    margin: 0 0 24px 0;
    padding: 0;
    font-size: 17px;
    color: rgb(142, 131, 117);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ability__how {
    flex-direction: row;
    align-items: center;
}

.ability__how-text {
    font-size: 17px;
    color: rgb(216, 203, 180);
    margin: 0 12px 0 0;
    padding: 0;
}

.ability__or {
    font-size: 15px;
    color: rgb(95, 87, 76);
    margin: 0 8px 0 4px;
    padding: 0;
}

.ability__continue {
    flex-direction: row;
    align-items: center;
    margin: 32px 0 0 0;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ability__continue-text {
    font-size: 15px;
    color: rgb(95, 87, 76);
    margin: 0 0 0 4px;
    padding: 0;
}

.ability__continue:hover > .ability__continue-text {
    color: rgb(232, 205, 138);
}
