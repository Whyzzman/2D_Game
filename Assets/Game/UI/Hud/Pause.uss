/*
 * The pause menu, from design/ui/menus/menus.html (2026-10-19): the scrim fades in over the
 * frozen game, one panel 560 px wide with gems at its corners, a column of words with the same
 * MenuFocus as the title. USS has no blur, so the frozen game is dimmed rather than blurred.
 */

.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

.pause--open {
    display: flex;
}

/* The settings take the place of the list rather than stacking over it. */
.pause--options > .pause__panel {
    display: none;
}

.pause__panel {
    width: 560px;
    background-color: rgba(18, 15, 12, 0.96);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 8px;
}

.pause__inset {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    border-width: 1px;
    border-color: rgba(138, 116, 52, 0.35);
}

.pause__header {
    padding: 32px 40px 0 40px;
    align-items: stretch;
}

.pause__title {
    font-size: 40px;
    letter-spacing: 8px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.pause__rule {
    margin: 4px 0 8px 0;
}

.pause__body {
    padding: 8px 24px 28px 24px;
}

/* Words without boxes, as on the title; the focus light is MenuFocus behind them. */
.pause__item,
.pause__item:hover,
.pause__item:active,
.pause__item.btn--focused,
.pause__item:disabled {
    min-height: 50px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.pause__item > .btn__text {
    font-size: 25px;
    letter-spacing: 4px;
    color: rgb(216, 203, 180);
    transition-property: color, letter-spacing;
    transition-duration: 0.16s, 0.32s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.pause__item:hover > .btn__text,
.pause__item.btn--focused > .btn__text {
    color: rgb(232, 205, 138);
    letter-spacing: 6px;
}

.pause__item.btn--danger.btn--focused > .btn__text,
.pause__item.btn--danger:hover > .btn__text {
    color: rgb(240, 185, 164);
}

.pause__item:disabled > .btn__text {
    color: rgb(95, 87, 76);
}

/* The buttons (.btn) and the points diamond (.pip) are in Menu/Options.uss, shared with the title screen. */

/* The key glyphs (.key) and the controls screen are in Menu/Controls.uss, shared with the title. */

.pause--controls > .pause__panel {
    display: none;
}

/* ---------- ability card (tutorial.html, frame 5): the game waits under it ---------- */

.ability {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 3, 3, 0.78);
    align-items: center;
    justify-content: center;
    display: none;
}

.ability--open {
    display: flex;
}

.ability__card {
    width: 720px;
    padding: 32px 48px;
    align-items: center;
    background-color: rgb(23, 19, 15);
    border-width: 1px;
    border-color: rgb(107, 90, 66);
    border-radius: 8px;
}

.ability__kicker {
    font-size: 13px;
    letter-spacing: 4px;
    color: rgb(138, 116, 52);
    margin: 0;
    padding: 0;
}

.ability__name {
    margin: 12px 0 8px 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
}

.ability__rule {
    width: 60%;
    height: 1px;
    margin: 16px 0;
    background-color: rgb(138, 116, 52);
}

.ability__text {
    margin: 0 0 24px 0;
    padding: 0;
    font-size: 17px;
    color: rgb(142, 131, 117);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ability__how {
    flex-direction: row;
    align-items: center;
}

.ability__how-text {
    font-size: 17px;
    color: rgb(216, 203, 180);
    margin: 0 12px 0 0;
    padding: 0;
}

.ability__or {
    font-size: 15px;
    color: rgb(95, 87, 76);
    margin: 0 8px 0 4px;
    padding: 0;
}

.ability__continue {
    flex-direction: row;
    align-items: center;
    margin: 32px 0 0 0;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ability__continue-text {
    font-size: 15px;
    color: rgb(95, 87, 76);
    margin: 0 0 0 4px;
    padding: 0;
}

.ability__continue:hover > .ability__continue-text {
    color: rgb(232, 205, 138);
}
